#: user-docs/C/default-apps.xml:17
msgid ""
"Xubuntu comes with a collection of preinstalled applications curated by the "
"Xubuntu team which are accessible from the <guiicon><inlinemediaobject "
"role=\"icon-menu\"><imageobject><imagedata role=\"icon\" "
"fileref=\"../libs/images/icon_menu.png\"/></imageobject></inlinemediaobject></guiicon>"
